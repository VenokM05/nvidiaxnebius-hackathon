# Repo Referee — configuration
# Without a key the app runs in deterministic "pre-analyzer" mode (demo-safe).
# With a key, reviews go through Nebius Token Factory (OpenAI-compatible).
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.studio.nebius.ai/v1

# Optional. Rolling 24h ceiling on model spend, in USD (default 2). When it is
# exhausted, reviews keep working on the free deterministic analyzer and the
# summary says so. Only matters on a public deployment where the key is set.
DEMO_BUDGET_USD=2
